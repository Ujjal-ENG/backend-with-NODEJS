# App
PORT=3000
NODE_ENV=development
APP_TIMEZONE=Asia/Dhaka

# Caching and scraping
CACHE_TTL_MINUTES=15
SCRAPE_TIMEOUT_MS=45000
SOURCE_TIMEOUT_MS=18000
REQUEST_TIMEOUT_MS=15000
REQUEST_DELAY_MS=900
REQUEST_JITTER_MS=300
SCRAPE_CONCURRENCY=2
MAX_PAGES_PER_SOURCE=5
MAX_DEALS_PER_SOURCE=50
COMPARE_MIN_SCORE=0.35
COMPARE_MAX_RESULTS=20
SEARCH_MIN_SCORE=0.2
SEARCH_MAX_RESULTS=8

# Manual refresh endpoint protection
REFRESH_TOKEN=replace-with-strong-token

# Puppeteer (required in most free hosts)
PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox
# PUPPETEER_EXECUTABLE_PATH=

# Optional Facebook Graph integration
# FACEBOOK_ACCESS_TOKEN=
# FACEBOOK_PAGE_IDS=page_id_1,page_id_2

# Optional scraper user-agent override
# SCRAPER_USER_AGENT=Mozilla/5.0 ...
